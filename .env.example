# qdata backend selection
QDATA_BACKEND=mock

# Switch to SQL backend after PostgreSQL/ClickHouse are available:
# QDATA_BACKEND=sql
# QDATA_POSTGRES_DSN=postgresql://qdata:qdata@localhost:15432/qdata
# QDATA_CLICKHOUSE_DSN=http://qdata:qdata@localhost:18123/default

# REST API
# QDATA_API_BACKEND=sql
# QDATA_API_TOKENS=devtoken,smoketoken
# QDATA_API_TOKEN_SCOPES=read,admin

# Mu scheduler
# QDATA_MU_POLL_SECONDS=30
# QDATA_MU_SCHEDULER_ID=mu-local

# Automation local HMAC dry-run secrets
# QDATA_ALPHA2_HMAC_SECRET=alpha2-local-secret
# QDATA_GAMMA2_HMAC_SECRET_CURRENT=gamma2-current-secret
# QDATA_GAMMA2_HMAC_SECRET_NEXT=gamma2-next-secret
# QDATA_DELTA2_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-with-wecom-robot-key
# QDATA_DELTA6_WECOM_CALLBACK_SECRET=delta6-local-secret
# QDATA_ZETA6_WECOM_CALLBACK_SECRET_NEXT=zeta6-next-local-secret

# Nu deployment health
# QDATA_NU_ENVIRONMENT=local
# QDATA_NU_RELEASE_CODE=nu-local-202607260001
# QDATA_NU_VERSION_LABEL=dev
# QDATA_NU_GIT_REF=local
# QDATA_API_BASE_URL=http://127.0.0.1:18080
# QDATA_API_TOKEN=devtoken

# Iota tenant/API bootstrap and local smoke
# QDATA_IOTA_BOOTSTRAP_TOKEN=iotatoken
# QDATA_IOTA_TENANT_CODE=demo
# QDATA_IOTA_PROJECT_CODE=quant-research
# QDATA_IOTA_PRINCIPAL_CODE=research-bot

# Xi product/pricing/budget bootstrap
# QDATA_XI_TENANT_CODE=demo
# QDATA_XI_PROJECT_CODE=quant-research
# QDATA_XI_COST_CENTER=research
# QDATA_XI_MONTHLY_BUDGET_AMOUNT=0.15

# Optional commercial vendor HTTP adapter
# QDATA_VENDOR_SOURCE_CODE=vendor_http
# QDATA_VENDOR_BASE_URL=https://vendor.example/api
# QDATA_VENDOR_DAILY_PATH=/daily
# QDATA_VENDOR_TOKEN=replace-with-secret
# QDATA_VENDOR_AUTH_MODE=bearer
# QDATA_VENDOR_API_KEY_HEADER=X-API-Key
# QDATA_VENDOR_QUERY_TOKEN_PARAM=token
# QDATA_VENDOR_RATE_LIMIT_PER_MIN=120
# QDATA_VENDOR_RETRY_LIMIT=2
# QDATA_VENDOR_RETRY_SLEEP_SECONDS=0.5
# QDATA_VENDOR_TIMEOUT_SECONDS=30
# QDATA_VENDOR_RESPONSE_ROWS_KEY=data

# Eta-6 vendor production primary-source closure
# QDATA_ETA6_ENVIRONMENT=local
# QDATA_ETA6_CLOSURE_SCOPE=production_primary
# QDATA_ETA6_CLOSURE_MODE=review_only
# QDATA_ETA6_REQUIRE_REAL_VENDOR_ENV=true
# QDATA_ETA6_EXTERNAL_PROBE_ALLOWED=false
# QDATA_ETA6_MIN_STABILITY_SCORE=70
# QDATA_ETA6_ALLOW_COST_WATCH=false

# Nu-5 free source recovery health
# QDATA_NU5_FREE_SOURCE_LOOKBACK_HOURS=24
# QDATA_NU5_FREE_SOURCE_APPROVAL_SLA_HOURS=4
# QDATA_NU5_FREE_SOURCE_MAX_BACKLOG_ACTIONS=50
# QDATA_NU5_FREE_SOURCE_MAX_FAILURE_RATE=0.5
# QDATA_NU5_FREE_SOURCE_MAX_STALE_MINUTES=90

# Xi-5 free source admission matrix
# QDATA_XI5_FREE_SOURCE_LOOKBACK_DAYS=30
# QDATA_XI5_FREE_SOURCE_MIN_VALIDATOR_SCORE=55
# QDATA_XI5_FREE_SOURCE_MIN_BACKUP_SCORE=75
# QDATA_XI5_FREE_SOURCE_MIN_PRIMARY_SCORE=90
# QDATA_XI5_FREE_SOURCE_MIN_COVERAGE_RATE=0.95
# QDATA_XI5_FREE_SOURCE_MAX_CONFLICT_RATE_BPS=5
